---
import { SOCIAL_LINKS } from '../consts';
import { getContributions } from '../lib/github';

// The past year of GitHub contributions as a heatmap, drawn at build time in the site's own colours.
const data = await getContributions();

const monthFmt = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const longMonth = new Intl.DateTimeFormat('en-US', { month: 'long', timeZone: 'UTC' });
const ordinal = (n: number) => {
	const suffix = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
	return `${n}${suffix}`;
};
// Worded as on GitHub: "4 contributions on September 2nd."
const label = (d: { date: string; count: number }) => {
	const date = new Date(`${d.date}T00:00:00Z`);
	return `${d.count === 0 ? 'No' : d.count} contribution${d.count === 1 ? '' : 's'} on ${longMonth.format(date)} ${ordinal(date.getUTCDate())}.`;
};

// A month name above each week where a new month begins (not the first column, which is usually a partial month).
const months = (data?.weeks ?? []).flatMap((week, i) => {
	const month = week[0].date.slice(0, 7);
	return i > 0 && month !== data!.weeks[i - 1][0].date.slice(0, 7)
		? [{ col: i + 1, name: monthFmt.format(new Date(`${week[0].date}T00:00:00Z`)) }]
		: [];
});
---

{
	data && (
		<section class="github" aria-labelledby="github-heading">
			<h2 id="github-heading" class="rule-label">
				GitHub activity
			</h2>
			<div class="card">
				<p class="total">
					<strong>{data.total.toLocaleString('en-GB')}</strong> contributions in the last year
				</p>
				<div class="scroller">
					<div
						class="grid"
						style={`--weeks: ${data.weeks.length}`}
						role="img"
						aria-label={`GitHub contribution calendar: ${data.total} contributions in the last year`}
					>
						{months.map((m) => (
							<span class="month" style={`grid-column: ${m.col}`} aria-hidden="true">
								{m.name}
							</span>
						))}
						{data.weeks.map((week, i) =>
							week.map((d) => (
								<span
									class="day"
									data-level={d.level}
									style={`grid-column: ${i + 1}; grid-row: ${new Date(`${d.date}T00:00:00Z`).getUTCDay() + 2}`}
									data-label={label(d)}
								/>
							)),
						)}
					</div>
				</div>
				<div class="tip" role="tooltip" hidden />
				<div class="foot">
					<a class="text-link" href={SOCIAL_LINKS.github} target="_blank" rel="noopener">
						View on GitHub
					</a>
					<span class="legend" aria-hidden="true">
						Less
						{[0, 1, 2, 3, 4].map((l) => (
							<span class="day" data-level={l} />
						))}
						More
					</span>
				</div>
			</div>
		</section>
	)
}

<!-- Narrow screens show the most recent weeks: start the scroller at its right edge. Hovering (or tapping) a
     square shows its count in a bubble above it, as on GitHub. -->
<script is:inline>
	document.querySelectorAll('.github .card').forEach((card) => {
		const scroller = card.querySelector('.scroller');
		const grid = card.querySelector('.grid');
		const tip = card.querySelector('.tip');
		scroller.scrollLeft = scroller.scrollWidth;

		const show = (day) => {
			tip.textContent = day.dataset.label;
			tip.hidden = false;
			const c = card.getBoundingClientRect();
			const d = day.getBoundingClientRect();
			const w = tip.offsetWidth;
			const center = d.left - c.left + d.width / 2;
			const left = Math.min(Math.max(center - w / 2, 4), c.width - w - 4);
			tip.style.left = `${left}px`;
			tip.style.top = `${d.top - c.top - tip.offsetHeight - 8}px`;
			tip.style.setProperty('--arrow', `${center - left}px`);
		};
		const hide = () => (tip.hidden = true);
		grid.addEventListener('pointerover', (e) => {
			const day = e.target.closest('.day');
			if (day) show(day);
		});
		grid.addEventListener('pointerleave', hide);
		scroller.addEventListener('scroll', hide, { passive: true });
		document.addEventListener('pointerdown', (e) => {
			if (!grid.contains(e.target)) hide();
		});
	});
</script>

<style>
	.card {
		position: relative;
		padding: var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius-l);
		background: var(--surface);
	}
	.total {
		margin-bottom: var(--space-4);
		color: var(--muted);
	}
	.total strong {
		color: var(--ink);
		font-weight: 600;
	}
	.scroller {
		overflow-x: auto;
		scrollbar-width: thin;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(var(--weeks), minmax(10px, 1fr));
		grid-template-rows: auto repeat(7, auto);
		gap: 3px;
		min-width: calc(var(--weeks) * 13px);
	}
	.month {
		grid-row: 1;
		margin-bottom: 2px;
		color: var(--muted);
		font-size: 0.75rem;
		line-height: 1.2;
		white-space: nowrap;
	}
	.day {
		display: block;
		aspect-ratio: 1;
		border-radius: 2px;
		background: var(--border);
	}
	.day[data-level='1'] {
		background: color-mix(in srgb, var(--accent) 30%, var(--border));
	}
	.day[data-level='2'] {
		background: color-mix(in srgb, var(--accent) 55%, var(--border));
	}
	.day[data-level='3'] {
		background: color-mix(in srgb, var(--accent) 80%, var(--border));
	}
	.day[data-level='4'] {
		background: var(--accent);
	}
	/* GitHub-style bubble with a small arrow pointing at the square. */
	.tip {
		position: absolute;
		z-index: 2;
		padding: 0.35rem 0.6rem;
		border-radius: var(--radius-s);
		background: var(--ink);
		color: var(--surface);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.3;
		white-space: nowrap;
		pointer-events: none;
		box-shadow: 0 4px 12px rgb(0 0 0 / 0.18);
	}
	.tip[hidden] {
		display: none;
	}
	.tip::after {
		content: '';
		position: absolute;
		top: 100%;
		left: var(--arrow, 50%);
		border: 5px solid transparent;
		border-top-color: var(--ink);
		transform: translateX(-50%);
	}
	.day:hover {
		outline: 1px solid var(--ink);
		outline-offset: -1px;
	}
	.legend .day:hover {
		outline: none;
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin-top: var(--space-4);
		font-size: 0.875rem;
	}
	.legend {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		color: var(--muted);
		font-size: 0.75rem;
	}
	.legend .day {
		width: 10px;
		margin-inline: 1px;
	}
	.legend .day:first-of-type {
		margin-left: var(--space-2);
	}
	.legend .day:last-of-type {
		margin-right: var(--space-2);
	}
</style>
