---
import { PROFILE, SOCIAL_LINKS } from '../consts';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container inner">
		<p>&copy; {year} {PROFILE.name} <span aria-hidden="true">·</span> <a href="/rss.xml">RSS</a></p>
		<ul class="social" role="list">
			<li>
				<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" label="LinkedIn" size={20} /></a>
			</li>
			<li>
				<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener"><Icon name="github" label="GitHub" size={20} /></a>
			</li>
			<li>
				<a href={`mailto:${PROFILE.email}`}><Icon name="mail" label="Email" size={20} /></a>
			</li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-9);
		padding-block: var(--space-6) calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}
	a {
		color: inherit;
	}
	a:hover {
		color: var(--ink);
	}
	.social {
		display: flex;
		gap: var(--space-2);
		margin: 0 calc(-1 * var(--space-3)) 0 0;
		padding: 0;
		list-style: none;
	}
	.social a {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
	}
	.social a:hover {
		background: var(--glass-active);
	}
</style>
