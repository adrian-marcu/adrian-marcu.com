---
import Icon from './Icon.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about/', label: 'About' },
	{ href: '/posts/', label: 'My blog' },
	{ href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<div class="pill glass">
		<nav aria-label="Main">
			<span class="thumb" aria-hidden="true"></span>
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<span class="divider" aria-hidden="true"></span>
		<button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
			<span class="icon-sun"><Icon name="sun" size={18} /></span>
			<span class="icon-moon"><Icon name="moon" size={18} /></span>
		</button>
	</div>
</header>

<script is:inline>
	(() => {
		// A glass bubble marks the current page. It follows the pointer over the links and springs back
		// on leave; after clicking a link it slides over from the previous page's position on the next page.
		const nav = document.querySelector('.site-header nav');
		const thumb = nav?.querySelector('.thumb');
		if (!thumb) return;
		const links = [...nav.querySelectorAll('a')];
		const current = links.find((a) => a.getAttribute('aria-current') === 'page');
		const place = (a) => {
			if (!a) return (thumb.style.opacity = '0');
			thumb.style.opacity = '1';
			thumb.style.transform = `translateX(${a.offsetLeft}px)`;
			thumb.style.width = `${a.offsetWidth}px`;
		};
		let from = null;
		try {
			from = JSON.parse(sessionStorage.getItem('nav-thumb') || 'null');
			sessionStorage.removeItem('nav-thumb');
		} catch {}
		if (from && current) {
			thumb.style.transform = `translateX(${from.x}px)`;
			thumb.style.width = `${from.w}px`;
			thumb.style.opacity = '1';
		} else {
			place(current);
		}
		nav.classList.add('has-thumb');
		requestAnimationFrame(() =>
			requestAnimationFrame(() => {
				nav.classList.add('animate');
				place(current);
			}),
		);
		links.forEach((a) => a.addEventListener('pointerenter', () => place(a)));
		nav.addEventListener('pointerleave', () => place(current));
		nav.addEventListener('click', (e) => {
			const start = current || e.target.closest('a');
			if (!start) return;
			try {
				sessionStorage.setItem('nav-thumb', JSON.stringify({ x: start.offsetLeft, w: start.offsetWidth }));
			} catch {}
		});
	})();

	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const root = document.documentElement;
		const dark = root.dataset.theme
			? root.dataset.theme === 'dark'
			: matchMedia('(prefers-color-scheme: dark)').matches;
		const next = dark ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
	});
</script>

<style>
	.skip-link {
		position: absolute;
		left: var(--space-4);
		top: calc(-1 * var(--space-8));
		z-index: 100;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-s);
		background: var(--btn-bg);
		color: var(--btn-ink);
		font-weight: 500;
		text-decoration: none;
	}
	.skip-link:focus {
		top: calc(env(safe-area-inset-top, 0px) + var(--space-3));
	}
	/* A floating frosted-glass pill that stays at the top while the page scrolls underneath it. */
	.site-header {
		position: sticky;
		top: calc(env(safe-area-inset-top, 0px) + 12px);
		z-index: 50;
		display: flex;
		justify-content: center;
		padding: calc(env(safe-area-inset-top, 0px) + 12px) var(--gutter) 0;
		margin-top: calc(-1 * env(safe-area-inset-top, 0px));
		pointer-events: none;
	}
	.pill {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		max-width: 100%;
		padding: 5px;
		border-radius: 999px;
		pointer-events: auto;
	}
	nav {
		position: relative;
	}
	/* The sliding bubble behind the current (or hovered) link, with a soft spring like iOS. */
	.thumb {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		border-radius: 999px;
		background: var(--glass-active);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			inset 0 0 0 1px var(--glass-border);
		opacity: 0;
		pointer-events: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.animate .thumb {
			transition:
				transform 0.45s cubic-bezier(0.3, 1.35, 0.5, 1),
				width 0.45s cubic-bezier(0.3, 1.35, 0.5, 1),
				opacity 0.2s ease;
		}
	}
	nav ul {
		position: relative;
		display: flex;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 0 var(--space-4);
		border-radius: 999px;
		color: var(--muted);
		font-size: 0.9375rem;
		font-weight: 500;
		white-space: nowrap;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--ink);
	}
	nav a[aria-current='page'] {
		color: var(--ink);
	}
	/* Without JavaScript there's no bubble, so the current link gets its own background. */
	nav:not(.has-thumb) a[aria-current='page'] {
		background: var(--glass-active);
	}
	.divider {
		width: 1px;
		height: 20px;
		margin-inline: 2px;
		background: var(--glass-border);
	}
	.theme-toggle {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: var(--ink);
		background: var(--glass-active);
	}
	.icon-moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .icon-moon {
		display: block;
	}
	:global(:root[data-theme='dark']) .icon-sun {
		display: none;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .icon-moon {
			display: block;
		}
		:global(:root:not([data-theme='light'])) .icon-sun {
			display: none;
		}
	}
	@media (max-width: 420px) {
		.pill {
			gap: 0;
			padding: 4px;
		}
		nav a {
			padding: 0 0.6rem;
			font-size: 0.875rem;
		}
		.divider {
			display: none;
		}
	}
</style>
