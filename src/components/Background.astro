---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import upbLogo from '../assets/logos/upb.jpg';
import { EDUCATION } from '../consts';

// Work and Education as tabs. Without JavaScript both panels simply show one after the other.

const roles = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

// Consecutive roles at the same company are shown under one entry (e.g. the two ING positions).
type Role = (typeof roles)[number]['data'];
const companies: { company: string; url?: string; logo?: Role['logo']; roles: Role[] }[] = [];
for (const { data } of roles) {
	const last = companies.at(-1);
	if (last?.company === data.company) last.roles.push(data);
	else companies.push({ company: data.company, url: data.url, logo: data.logo, roles: [data] });
}

// A neutral monogram stands in for a logo: the short name if there is one ("ING", "A2X"), else the initial.
const monogram = (name: string) => {
	const first = name.split(/[\s.]/)[0];
	return first.length <= 3 ? first.toUpperCase() : first[0].toUpperCase();
};
---

<div class="background" data-tabs>
	<div class="tablist glass" role="tablist" aria-label="Background" data-active="0" hidden>
		<button type="button" role="tab" id="tab-work" aria-controls="panel-work" aria-selected="true">Work</button>
		<button type="button" role="tab" id="tab-education" aria-controls="panel-education" aria-selected="false" tabindex="-1">
			Education
		</button>
	</div>

	<section id="panel-work" class="panel" role="tabpanel" aria-labelledby="tab-work" tabindex="0">
		<h2 class="sr-only">Work</h2>
		<ol class="timeline" role="list">
			{
				companies.map(({ company, url, logo, roles }) => (
					<li class="entry">
						{logo ? (
							<Image class="logo" src={logo} alt={`${company} logo`} width={52} height={52} densities={[1, 2]} />
						) : (
							<span class="logo" aria-hidden="true">
								{monogram(company)}
							</span>
						)}
						<div class="body">
							<h3 class="org">
								{url ? (
									<a href={url} target="_blank" rel="noopener">
										{company}
									</a>
								) : (
									company
								)}
							</h3>
							{roles.map((role) => (
								<div class="role">
									<p class="role-line">
										<span class="title">{role.role}</span>
										<span class="dates">
											{role.start} – {role.end}
										</span>
									</p>
									<p class="meta">
										{role.employment} · {role.location}
										{role.project && <> · {role.project}</>}
									</p>
									{role.intro && <p class="intro">{role.intro}</p>}
									<ul class="points">
										{role.highlights.map((item) => (
											<li>{item}</li>
										))}
									</ul>
									{role.skills.length > 0 && (
										<p class="skills">
											<strong>Skills:</strong> {role.skills.join(', ')}
										</p>
									)}
								</div>
							))}
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section id="panel-education" class="panel" role="tabpanel" aria-labelledby="tab-education" tabindex="0">
		<h2 class="sr-only">Education</h2>
		<ol class="timeline" role="list">
			{
				EDUCATION.map((e) => (
					<li class="entry">
						<Image class="logo" src={upbLogo} alt="University POLITEHNICA of Bucharest logo" width={52} height={52} densities={[1, 2]} />
						<div class="body">
							<h3 class="org">{e.school}</h3>
							<p class="role-line">
								<span class="title">{e.degree}</span>
								<span class="dates">{e.years}</span>
							</p>
							{e.note && (
								<ul class="points">
									<li>{e.note}</li>
								</ul>
							)}
						</div>
					</li>
				))
			}
		</ol>
	</section>
</div>

<!-- Progressive enhancement: turn the two stacked sections into accessible tabs. -->
<script is:inline>
	(() => {
		const root = document.currentScript.previousElementSibling;
		const list = root.querySelector('[role="tablist"]');
		const tabs = [...list.querySelectorAll('[role="tab"]')];
		const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')));
		const select = (i, focus) => {
			list.dataset.active = String(i);
			tabs.forEach((t, j) => {
				t.setAttribute('aria-selected', String(i === j));
				t.tabIndex = i === j ? 0 : -1;
				panels[j].hidden = i !== j;
			});
			if (focus) tabs[i].focus();
		};
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => select(i));
			t.addEventListener('keydown', (e) => {
				const k = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
				if (k) select((i + k + tabs.length) % tabs.length, true);
				if (e.key === 'Home') select(0, true);
				if (e.key === 'End') select(tabs.length - 1, true);
			});
		});
		list.hidden = false;
		root.classList.add('is-tabs');
		select(0);
	})();
</script>

<style>
	/* iOS-style segmented control: a glass track with a "thumb" that slides to the selected tab. */
	.tablist {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
		margin-bottom: var(--space-4);
		padding: 4px;
		border-radius: 999px;
	}
	.tablist::before {
		content: '';
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 4px;
		width: calc(50% - 6px);
		border-radius: 999px;
		background: var(--glass-thumb);
		box-shadow:
			inset 0 1px 0 var(--glass-highlight),
			0 1px 2px rgb(0 0 0 / 0.12),
			0 3px 10px -2px rgb(0 0 0 / 0.15);
	}
	.tablist[data-active='1']::before {
		transform: translateX(calc(100% + 4px));
	}
	@media (prefers-reduced-motion: no-preference) {
		.tablist::before {
			transition: transform 0.35s cubic-bezier(0.3, 1.3, 0.5, 1);
		}
	}
	.tablist[hidden] {
		display: none;
	}
	[role='tab'] {
		position: relative;
		z-index: 1;
		min-height: 44px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		font: 500 1rem / 1 var(--font-sans);
		cursor: pointer;
	}
	[role='tab']:hover {
		color: var(--ink);
	}
	[role='tab'][aria-selected='true'] {
		color: var(--ink);
	}
	.panel {
		border: 1px solid var(--border);
		border-radius: var(--radius-l);
		background: var(--surface);
	}
	.panel + .panel {
		margin-top: var(--space-5);
	}
	.is-tabs .panel + .panel {
		margin-top: 0;
	}
	.panel:focus-visible {
		outline-offset: 2px;
	}

	.timeline {
		position: relative;
		margin: 0;
		padding: var(--space-5) var(--space-5) var(--space-5) 0;
		list-style: none;
	}
	/* The vertical line that threads the logos together. */
	.timeline::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--space-5) + 26px);
		border-left: 1px solid var(--border);
	}
	.entry {
		position: relative;
		display: grid;
		grid-template-columns: calc(var(--space-5) * 2 + 52px) 1fr;
	}
	.entry + .entry {
		margin-top: var(--space-6);
	}
	.logo {
		position: relative;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		margin-left: var(--space-5);
		border: 1px solid var(--border-strong);
		border-radius: 50%;
		background: #ffffff;
		object-fit: cover;
		color: #0b1120;
		font-family: var(--font-serif);
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.body {
		min-width: 0;
	}
	.org {
		font-size: var(--step-1);
		line-height: 1.4;
		padding-top: 0.7rem;
	}
	.org a {
		text-decoration: none;
	}
	.org a:hover {
		text-decoration: underline;
	}
	.role + .role {
		margin-top: var(--space-5);
	}
	.role-line {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0 var(--space-4);
		margin-top: var(--space-1);
	}
	.title {
		color: var(--muted);
		font-size: var(--step-0);
		font-weight: 500;
	}
	.dates {
		color: var(--muted);
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.meta {
		color: var(--muted);
		font-size: 0.875rem;
	}
	.intro {
		margin-top: var(--space-3);
	}
	.points {
		display: grid;
		gap: var(--space-2);
		margin: var(--space-3) 0 0;
		padding-left: 1.1rem;
		list-style: disc;
	}
	.skills {
		margin-top: var(--space-3);
		color: var(--muted);
		font-size: 0.875rem;
	}
	.skills strong {
		color: var(--ink-2);
	}

	@media (max-width: 560px) {
		.timeline {
			padding: var(--space-4);
		}
		.timeline::before {
			display: none;
		}
		.entry {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
		.logo {
			margin-left: 0;
		}
		.org {
			padding-top: 0;
		}
	}
</style>
