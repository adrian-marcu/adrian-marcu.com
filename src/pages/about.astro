---
import { Image } from 'astro:assets';
import avatar from '../assets/photos/portrait.png';
import Icon from '../components/Icon.astro';
import { INTRO, PROFILE, SKILLS, SOCIAL_LINKS } from '../consts';
import Base from '../layouts/Base.astro';
import { PAGES } from '../lib/pages';
import { person } from '../lib/person';
import { getCompanies, monogram, span } from '../lib/work';

const companies = await getCompanies();

// From the previous About page, in Adrian's own words.
const focus = [
	'Increasing software delivery and prototyping speed',
	'Using data to make better decisions',
	'Improving the resiliency and reliability of software',
	'Saving hundreds of hours of engineering time through effective problem-solving and creative solutions',
	'Mentoring teams and engineering leaders to set up engineering organizations for success',
	'Strong communication and collaboration skills, able to work effectively with both technical and non-technical stakeholders',
	'Quickly understanding complex systems and identifying opportunities for improvement',
];

const profilePage = { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: person };
---

<Base title={PAGES.about.title} description={PAGES.about.description} image="/og/about.png" type="profile" jsonLd={profilePage}>
	<header class="container intro">
		<div>
			<h1>About me</h1>
			<p class="lead">{INTRO}</p>
			<p class="summary">{PROFILE.summary}</p>
			<div class="actions">
				<a class="btn btn-secondary" href={PROFILE.resume} download>
					Resume <Icon name="file" /><span class="sr-only">(PDF)</span>
				</a>
				<a class="btn btn-secondary" href={SOCIAL_LINKS.booking} target="_blank" rel="noopener">
					<Icon name="calendar" /> Book an appointment
				</a>
			</div>
		</div>
		<Image
			src={avatar}
			alt="Portrait of Adrian Marcu"
			widths={[200, 400]}
			sizes="200px"
			loading="eager"
			class="portrait"
		/>
	</header>

	<div class="container sections">
		<section aria-labelledby="focus-heading">
			<h2 id="focus-heading" class="rule-label">What I bring</h2>
			<ul class="checks">
				{focus.map((item) => <li>{item}</li>)}
			</ul>
		</section>

		<section aria-labelledby="skills-heading">
			<h2 id="skills-heading" class="rule-label">Skills</h2>
			<dl class="skills">
				{
					SKILLS.map(({ group, items }) => (
						<div>
							<dt>{group}</dt>
							<dd>{items.join(', ')}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section aria-labelledby="clients-heading">
			<h2 id="clients-heading" class="rule-label">Companies and clients</h2>
			<ul class="clients" role="list">
				{
					companies.map((c) => (
						<li>
							<a class="client" href={`/#${c.id}`}>
								{c.logo ? (
									<Image class="client-logo" src={c.logo} alt="" width={44} height={44} densities={[1, 2]} />
								) : (
									<span class="client-logo" aria-hidden="true">
										{monogram(c.company)}
									</span>
								)}
								<span class="client-text">
									<span class="client-name">{c.company}</span>
									<span class="client-dates">{span(c)}</span>
									{c.clients.length > 0 && <span class="client-for">Clients: {c.clients.join(', ')}</span>}
								</span>
								<Icon name="arrow" />
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Base>

<style>
	.intro {
		display: grid;
		gap: var(--space-6);
		padding-block: var(--space-8) var(--space-8);
	}
	.intro .lead {
		margin-top: var(--space-5);
	}
	.summary {
		max-width: var(--measure);
		margin-top: var(--space-4);
		color: var(--muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}
	.portrait {
		grid-row: 1;
		width: 140px;
		aspect-ratio: 1;
		object-fit: cover;
		object-position: 50% 25%;
		border-radius: 50%;
		border: 1px solid var(--border);
	}
	.sections {
		display: grid;
		gap: var(--space-8);
	}
	.checks {
		display: grid;
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.checks li {
		position: relative;
		padding-left: 1.75rem;
	}
	.checks li::before {
		content: '';
		position: absolute;
		left: 0.15rem;
		top: 0.5em;
		width: 0.7rem;
		height: 0.4rem;
		border-left: 2px solid var(--ink);
		border-bottom: 2px solid var(--ink);
		transform: rotate(-45deg);
	}
	.skills {
		display: grid;
		gap: var(--space-4);
		margin: 0;
	}
	.skills div {
		display: grid;
		grid-template-columns: 13rem 1fr;
		gap: var(--space-1) var(--space-5);
	}
	.skills dt {
		color: var(--ink);
		font-weight: 600;
	}
	.skills dd {
		margin: 0;
	}
	/* Logo cards that link to each company's entry in the home page's Work timeline. */
	.clients {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.client {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		height: 100%;
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius-l);
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
	}
	.client:hover {
		border-color: var(--border-strong);
	}
	.client:hover .client-name {
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}
	.client-logo {
		flex: none;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--border-strong);
		border-radius: 50%;
		background: #ffffff;
		object-fit: cover;
		color: #0b1120;
		font-family: var(--font-serif);
		font-size: 0.875rem;
		font-weight: 700;
	}
	.client-text {
		display: grid;
		flex: 1;
		min-width: 0;
	}
	.client-name {
		font-weight: 600;
		line-height: 1.35;
	}
	.client-dates,
	.client-for {
		color: var(--muted);
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
	}
	.client-for {
		margin-top: var(--space-1);
	}
	.client :global(svg) {
		flex: none;
		width: 1.1em;
		height: 1.1em;
		color: var(--muted);
	}
	@media (prefers-reduced-motion: no-preference) {
		.client {
			transition: border-color 0.2s ease;
		}
		.client :global(svg) {
			transition: transform 0.2s ease;
		}
		.client:hover :global(svg) {
			transform: translateX(3px);
		}
	}
	@media (max-width: 640px) {
		.skills div {
			grid-template-columns: 1fr;
		}
	}
	@media (min-width: 760px) {
		.intro {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: start;
		}
		.portrait {
			grid-row: auto;
			width: 200px;
		}
	}
</style>
