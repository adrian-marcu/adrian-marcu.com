---
import avatar from '../assets/photos/portrait.png';
import Background from '../components/Background.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import PhotoStack from '../components/PhotoStack.astro';
import { EDUCATION, PROFILE, SITE_URL, SKILLS, SOCIAL_LINKS } from '../consts';
import Base from '../layouts/Base.astro';
import { PAGES } from '../lib/pages';
import { getPosts, readingTime } from '../lib/posts';

const recent = (await getPosts()).slice(0, 2);

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${SITE_URL}/#person`,
	name: PROFILE.name,
	jobTitle: PROFILE.jobTitle,
	description: PROFILE.summary,
	url: `${SITE_URL}/`,
	image: new URL(avatar.src, SITE_URL).href,
	email: `mailto:${PROFILE.email}`,
	address: { '@type': 'PostalAddress', addressLocality: 'Bucharest', addressCountry: 'RO' },
	alumniOf: { '@type': 'CollegeOrUniversity', name: EDUCATION[0].school },
	knowsAbout: SKILLS.flatMap((group) => group.items),
	sameAs: [SOCIAL_LINKS.linkedin, SOCIAL_LINKS.github],
};
---

<Base title={PAGES.home.title} description={PAGES.home.description} image="/og/home.png" type="profile" jsonLd={person}>
	<section class="container hero" aria-labelledby="hero-heading">
		<div class="text">
			<h1 id="hero-heading">Hi, I'm Adrian.</h1>
			<p class="role">
				Senior Fullstack Software Engineer from Bucharest, Romania <span class="flag" role="img" aria-label="Romanian flag">🇷🇴</span>
			</p>
			<p class="lead">
				11+ years of expertise in Java, Spring Boot, React and cloud technologies (GCP, AWS), delivering
				scalable, high-performance solutions for startups and enterprises.
			</p>
			<p class="cta">
				<a href="/contact/">Hiring for a project? Let's talk <span class="hop" aria-hidden="true">↘</span></a>
			</p>
			<p class="cta-sub">
				Prefer a call? <a href={SOCIAL_LINKS.booking} target="_blank" rel="noopener">Book an appointment</a> in my calendar.
			</p>
			<div class="links">
				<a class="btn glass glass-btn" href={PROFILE.resume} download>
					Resume <Icon name="file" /><span class="sr-only">(PDF)</span>
				</a>
				<a class="icon-link glass" href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" label="LinkedIn" size={22} /></a>
				<a class="icon-link glass" href={SOCIAL_LINKS.github} target="_blank" rel="noopener"><Icon name="github" label="GitHub" size={22} /></a>
				<a class="icon-link glass" href={`mailto:${PROFILE.email}`}><Icon name="mail" label="Email" size={22} /></a>
			</div>
		</div>
		<PhotoStack />
	</section>

	<section class="container" aria-label="Work and education">
		<Background />
	</section>

	<section class="container recent" aria-labelledby="recent-heading">
		<div class="recent-head">
			<h2 id="recent-heading" class="serif">Recent posts</h2>
			<a class="more" href="/posts/">View more<span class="sr-only"> posts</span> <Icon name="arrow" /></a>
		</div>
		<ul class="posts" role="list">
			{
				recent.map((post) => (
					<li class="post">
						<div>
							<h3>
								<a href={`/${post.id}/`}>{post.data.title}</a>
							</h3>
							<p class="desc">{post.data.description}</p>
						</div>
						<p class="meta">
							<span>
								<Icon name="calendar" />
								<FormattedDate date={post.data.pubDate} />
							</span>
							<span>
								<Icon name="clock" />
								{readingTime(post.body)}
							</span>
						</p>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.hero {
		display: grid;
		gap: var(--space-7);
		padding-block: var(--space-8) var(--space-8);
	}
	.role {
		margin-top: var(--space-3);
		color: var(--ink);
		font-size: var(--step-1);
		font-weight: 500;
	}
	.lead {
		margin-top: var(--space-5);
		max-width: 34rem;
	}
	.cta {
		margin-top: var(--space-6);
		font-size: var(--step-1);
		font-weight: 600;
	}
	.cta a {
		color: var(--ink);
		text-decoration: none;
	}
	.cta a:hover {
		text-decoration: underline;
	}
	.flag {
		display: inline-block;
		font-size: 1.05em;
		line-height: 1;
		vertical-align: -0.05em;
	}
	/* The arrow keeps hopping to draw the eye to the call to action. */
	.hop {
		display: inline-block;
		margin-left: 0.15em;
	}
	@media (prefers-reduced-motion: no-preference) {
		.hop {
			animation: hop 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
		}
		@keyframes hop {
			0%,
			100% {
				transform: translateY(-3px);
			}
			50% {
				transform: translateY(4px);
			}
		}
	}
	.cta-sub {
		margin-top: var(--space-1);
		color: var(--ink-2);
		font-size: 0.9375rem;
	}
	.cta-sub a {
		color: var(--ink);
		text-decoration-color: var(--border-strong);
	}
	.cta-sub a:hover {
		text-decoration-color: currentColor;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}
	.links {
		gap: var(--space-3);
	}
	.glass-btn {
		min-height: 48px;
		padding-inline: 1.375rem;
		border-radius: 999px;
		color: var(--ink);
	}
	.icon-link {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		color: var(--ink-2);
	}
	.glass-btn:hover,
	.icon-link:hover {
		color: var(--ink);
		background: var(--glass-active);
	}
	@media (prefers-reduced-motion: no-preference) {
		.glass-btn,
		.icon-link {
			transition:
				transform 0.2s ease,
				background-color 0.2s ease;
		}
		.glass-btn:active,
		.icon-link:active {
			transform: scale(0.95);
		}
	}

	@media (min-width: 760px) {
		.hero {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
		}
	}

	.recent {
		margin-top: var(--space-9);
	}
	.recent-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-5);
	}
	.recent-head h2 {
		font-size: var(--step-4);
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 44px;
		color: var(--muted);
		font-size: var(--step-1);
		text-decoration: none;
	}
	.more:hover {
		color: var(--ink);
	}
	.more :global(svg) {
		width: 1.1em;
		height: 1.1em;
	}
	.posts {
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-l);
		background: var(--surface);
	}
	.post {
		position: relative;
		display: grid;
		gap: var(--space-3) var(--space-6);
		padding: var(--space-6);
	}
	.post + .post {
		border-top: 1px solid var(--border-strong);
	}
	.post h3 {
		font-size: var(--step-2);
		line-height: 1.3;
	}
	.post h3 a {
		text-decoration: none;
	}
	/* The whole card is clickable; the title link stretches over it. */
	.post h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: var(--radius-l);
	}
	.post h3 a:focus-visible {
		outline: none;
	}
	.post:focus-within {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
		border-radius: var(--radius-l);
	}
	.post:hover h3 a {
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}
	.desc {
		margin-top: var(--space-3);
		color: var(--muted);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-5);
		color: var(--muted);
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.meta span {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}
	@media (min-width: 760px) {
		.post {
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.meta {
			flex-direction: column;
			align-items: flex-end;
			gap: var(--space-2);
			padding-top: 0.3rem;
		}
	}
</style>
