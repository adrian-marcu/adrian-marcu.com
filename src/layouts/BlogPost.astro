---
import '../styles/prose.css';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import { PROFILE, SITE_URL } from '../consts';
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt } = post.data;
const url = `${SITE_URL}/${post.id}/`;
const ogImage = `/og/posts/${post.id}.png`;

const blogPosting = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	image: new URL(ogImage, SITE_URL).href,
	author: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: PROFILE.name, url: `${SITE_URL}/` },
	publisher: { '@type': 'Person', '@id': `${SITE_URL}/#person`, name: PROFILE.name },
};
---

<Base
	title={`${title} · Adrian Marcu`}
	description={description}
	image={ogImage}
	type="article"
	publishedTime={pubDate}
	jsonLd={blogPosting}
>
	<article>
		<header class="container head">
			<p class="kicker"><a href="/posts/">← My blog</a></p>
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				<span aria-hidden="true">·</span>
				<span>{readingTime(post.body)}</span>
				{
					updatedDate && (
						<>
							<span aria-hidden="true">·</span>
							<span>
								Updated <FormattedDate date={updatedDate} />
							</span>
						</>
					)
				}
			</p>
		</header>
		{
			heroImage && (
				<div class="container hero">
					<Image
						src={heroImage}
						alt={heroAlt ?? `Cover image for the post “${title}”`}
						widths={[400, 720, 1080, 1440]}
						sizes="(min-width: 900px) 832px, calc(100vw - 2rem)"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			)
		}
		<div class="container">
			<div class="prose">
				<slot />
			</div>
			<footer class="byline">
				<p>
					Written by <a href="/about/">{PROFILE.name}</a>, {PROFILE.jobTitle.toLowerCase()}. Working on
					something similar? <a href="/contact/">Let's talk</a>.
				</p>
			</footer>
		</div>
	</article>
</Base>

<style>
	.head {
		max-width: calc(44rem + 2 * var(--gutter));
		margin-inline: auto;
	}
	.prose,
	.byline {
		max-width: 44rem;
		margin-inline: auto;
	}
	.head {
		padding-block: clamp(var(--space-7), 6vw, var(--space-8)) var(--space-6);
	}
	.kicker {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		color: var(--muted);
		font-size: 0.875rem;
	}
	.kicker a {
		color: inherit;
	}
	.kicker a:hover {
		color: var(--ink);
	}
	h1 {
		margin-top: var(--space-4);
		font-size: var(--step-4);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-5);
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.hero {
		max-width: calc(52rem + 2 * var(--gutter));
	}
	.hero img {
		width: 100%;
		aspect-ratio: 21 / 9;
		object-fit: cover;
		border-radius: var(--radius-l);
		border: 1px solid var(--border);
	}
	.prose {
		padding-block: var(--space-7) var(--space-6);
	}
	.byline {
		padding-top: var(--space-5);
		border-top: 1px solid var(--border);
		color: var(--muted);
	}
	.byline a {
		color: var(--accent);
	}
</style>
